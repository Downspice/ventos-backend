NODE_ENV=development
PORT=4000

MONGODB_URI=mongodb://127.0.0.1:27017/ventos

JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GOOGLE_CALLBACK_URL=http://127.0.0.1:4000/auth/google/callback

# Media uploads (production). Leave service role empty to use backend/uploads/ in development.
SUPABASE_URL=https://rcythllosjhgfuymbcjl.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=ventos
# Optional: API base for local upload URLs (defaults to http://127.0.0.1:PORT)
PUBLIC_API_URL=

RESEND_API_KEY=
EMAIL_FROM=Ventos <onboarding@resend.dev>

CLIENT_WEB_URL=http://127.0.0.1:5173
CLIENT_ADMIN_URL=http://127.0.0.1:5174

# Vercel / cloud (see docs/deploy-vercel.md)
# CORS_ALLOW_VERCEL=true
# CORS_EXTRA_ORIGINS=
# VERCEL sets VERCEL_URL and VERCEL_ENV automatically
